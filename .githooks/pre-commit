#!/bin/sh

export JAVA_HOME="/c/Users/Ivan/.jdks/ms-21.0.10"
export PATH="$JAVA_HOME/bin:$PATH"

echo "[pre-commit] Checking code formatting..."
mvn spotless:check --quiet 2>&1
if [ $? -ne 0 ]; then
  echo "[pre-commit] FAILED: Run 'mvn spotless:apply' then re-stage your changes."
  exit 1
fi

echo "[pre-commit] Compiling..."
mvn compile --quiet 2>&1
if [ $? -ne 0 ]; then
  echo "[pre-commit] FAILED: Fix compilation errors before committing."
  exit 1
fi

echo "[pre-commit] All checks passed."
exit 0